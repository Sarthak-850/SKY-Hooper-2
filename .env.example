# ========================================================
# SKY-Hooper Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT.
# ========================================================

# Server Port
PORT=3000

# Environment: 'development' or 'production'
NODE_ENV=development

# PostgreSQL Connection String:
# For production, provide your standard PostgreSQL database URL:
# e.g., postgresql://username:password@localhost:5432/skyhooper?sslmode=require
# If left blank, the backend automatically uses embedded PostgreSQL (PGlite) for zero-dependency local dev.
DATABASE_URL=

# JWT Authentication Secret (Use a strong, 32+ character random string in production)
JWT_SECRET=your_secure_random_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Cookie Signing Secret
COOKIE_SECRET=your_secure_random_cookie_secret_here

# CORS Configuration (allowed frontend origin(s), comma-separated or '*' for public access)
CORS_ORIGIN=*

# Client API Base URL (if frontend and backend are hosted on separate domains)
VITE_API_URL=

# Anti-Cheat & Physical Gameplay Limits
MAX_SCORE_RATE_PER_SEC=220
MIN_GAME_DURATION_SEC=3
MAX_ABSOLUTE_SCORE=1000000
COUNTRY_CHANGE_COOLDOWN_HOURS=24
